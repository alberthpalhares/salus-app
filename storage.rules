rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User documents under /usuarios/{userId}/documentos/**
    match /usuarios/{userId}/documentos/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
