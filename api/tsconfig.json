{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "../.vercel-api-out",
    "rootDir": ".."
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
