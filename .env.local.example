# Variáveis de ambiente — [APP_NAME]
# Copie este arquivo para .env.local e preencha os valores

# ──────────────────────────────────────────────
# Firebase (obtido do Console do Firebase)
# ──────────────────────────────────────────────
# Não é necessário se usando firebase-applet-config.json
# GOOGLE_CLOUD_PROJECT=your-project-id

# ──────────────────────────────────────────────
# Google OAuth (Console do Google Cloud → Credentials → OAuth 2.0 Client ID)
# Necessário para integração com Google Drive
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# URL pública do app (Vercel preenche automaticamente em produção)
# Em dev local, use http://localhost:3000
# ──────────────────────────────────────────────
APP_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Emails de administradores (separados por vírgula)
# Têm acesso ao painel /admin com métricas agregadas
# ──────────────────────────────────────────────
ADMIN_EMAILS=seu-email@gmail.com
